{
  "meta": {
    "title": "Onboarding Journey",
    "subtitle": "Board · Resource Sim",
    "briefing": "Your first week, one square at a time. Lap the board to collect every onboarding concept, bank coins at START, and mind the setbacks.",
    "roomSize": 12
  },
  "manifest": {
    "schemaVersion": "1.0.0",
    "id": "mapping-onboarding-journey",
    "templateId": "board-resource-sim.v1",
    "experienceId": "exp-onboarding-journey",
    "title": "Onboarding Journey",
    "target": "browser",
    "requiredRuntimeSystems": ["board-spaces", "dice-turns", "resource-changes", "events"],
    "assetSlots": [
      { "id": "board_theme", "type": "image", "required": false, "fallback": "default-board" }
