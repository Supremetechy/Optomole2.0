      },
      {
        "id": "bystander-new-hire-burst",
        "sourceElement": { "type": "distractor", "label": "New-hire onboarding burst", "description": "Twelve accounts created in an hour on the first Monday of the month — that is HR, not an attacker.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "bystander-target", "interactionType": "hold", "mechanic": "hold-fire", "reward": { "strategy": "discipline-bonus-on-hold", "xp": 60 }, "failureConditions": ["wrongful-engagement"], "spawnRules": { "placement": "template-default", "priority": 88 } }
      },

      {
        "id": "evidence-baseline-first",
        "sourceElement": { "type": "evidence", "label": "Baseline before you alert", "description": "Every one of these calls depends on knowing what your normal week actually looks like.", "mediaRefs": [] },
