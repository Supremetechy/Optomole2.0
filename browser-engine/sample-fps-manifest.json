{
  "meta": {
    "title": "Threat Recognition Range",
    "subtitle": "FPS · Target Gallery",
    "briefing": "Security onboarding, live-fire edition. Every target downrange is something that showed up in your logs this quarter. Engage the real threats — and leave the routine traffic standing.",
    "roundSize": 4
  },
  "manifest": {
    "schemaVersion": "1.0.0",
    "id": "mapping-threat-recognition-range",
    "templateId": "fps-target-gallery.v1",
    "experienceId": "exp-threat-recognition-range",
    "title": "Threat Recognition Range",
    "target": "browser",
    "requiredRuntimeSystems": ["first-person-camera", "billboard-depth", "hit-scan", "accuracy-score", "rounds"],
    "assetSlots": [
      { "id": "range_backdrop", "type": "image", "required": false, "fallback": "default-range" },
      { "id": "fire_audio", "type": "audio", "required": false, "fallback": "default-pickup" }
    ],
    "bindings": [
      {
        "id": "officer-briefing",
        "sourceElement": { "type": "npc-dialogue", "label": "Range Officer Vega", "description": "Anyone can hit everything. Qualification is knowing what not to shoot.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "npc", "interactionType": "talk", "mechanic": "npc-dialogue", "reward": { "strategy": "context-unlock", "xp": 0 }, "spawnRules": { "placement": "template-default", "priority": 100 } }
      },

      {
        "id": "threat-credential-stuffing",
        "sourceElement": { "type": "hazard", "label": "Credential stuffing burst", "description": "Hundreds of logins across many accounts from one address — reused passwords being tested at scale.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "hostile-target", "interactionType": "shoot", "mechanic": "engage", "reward": { "strategy": "accuracy-score-and-streak", "xp": 130, "currency": 8 }, "successConditions": ["complete:shoot"], "spawnRules": { "placement": "template-default", "priority": 98 } }
      },
      {
        "id": "threat-impossible-travel",
        "sourceElement": { "type": "hazard", "label": "Impossible travel login", "description": "Same account authenticating from two continents within minutes — a stolen session or stolen password.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "hostile-target", "interactionType": "shoot", "mechanic": "engage", "reward": { "strategy": "accuracy-score-and-streak", "xp": 130, "currency": 8 }, "successConditions": ["complete:shoot"], "spawnRules": { "placement": "template-default", "priority": 97 } }
      },
