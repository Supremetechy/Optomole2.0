        "gameBinding": { "gameEntityType": "hostile-target", "interactionType": "shoot", "mechanic": "engage", "reward": { "strategy": "accuracy-score-and-streak", "xp": 130, "currency": 8 }, "successConditions": ["complete:shoot"], "spawnRules": { "placement": "template-default", "priority": 96 } }
      },
      {
