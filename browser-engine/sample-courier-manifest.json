        "gameBinding": { "gameEntityType": "quest-objective", "interactionType": "pickup", "mechanic": "contract", "reward": { "strategy": "fare-on-delivery", "xp": 140, "currency": 14 }, "successConditions": ["complete:deliver"], "spawnRules": { "placement": "template-default", "priority": 89 } }
      },

      {
        "id": "why-audit-trail",
        "sourceElement": { "type": "evidence", "label": "Why it matters", "description": "An unexplained variance found by an auditor costs ten times what it costs to explain up front.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "evidence", "interactionType": "deliver", "mechanic": "evidence", "reward": { "strategy": "bonus-fare", "xp": 40 }, "spawnRules": { "placement": "template-default", "priority": 75 } }
      },
      {
        "id": "why-cutoff",
