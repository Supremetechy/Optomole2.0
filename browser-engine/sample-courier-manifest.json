        "gameBinding": { "gameEntityType": "quest-objective", "interactionType": "pickup", "mechanic": "contract", "reward": { "strategy": "fare-on-delivery", "xp": 120, "currency": 10 }, "successConditions": ["complete:deliver"], "spawnRules": { "placement": "template-default", "priority": 95 } }
      },
      {
        "id": "job-accruals",
