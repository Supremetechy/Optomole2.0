{
  "meta": {
    "title": "Quarter Close Run",
    "subtitle": "Open World · Courier",
    "briefing": "Every job on this board is a step in the month-end close. Run them in whatever order you like — but the auditors are circling, so don't let the heat build.",
    "districtSize": 4
  },
  "manifest": {
    "schemaVersion": "1.0.0",
