        "gameBinding": { "gameEntityType": "hazard", "interactionType": "evade", "mechanic": "patrol", "reward": { "strategy": "heat-penalty", "xp": 0 }, "failureConditions": ["heat:max"], "spawnRules": { "placement": "template-default", "priority": 88 } }
      },
      {
        "id": "blocker-manual-journals",
