        "gameBinding": { "gameEntityType": "hazard", "interactionType": "evade", "mechanic": "patrol", "reward": { "strategy": "heat-penalty", "xp": 0 }, "failureConditions": ["heat:max"], "spawnRules": { "placement": "template-default", "priority": 87 } }
      },
      {
        "id": "blocker-spreadsheet-drift",
        "sourceElement": { "type": "hazard", "label": "Spreadsheet drift", "description": "Three versions of the same schedule in three inboxes — nobody knows which one closed.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "hazard", "interactionType": "evade", "mechanic": "patrol", "reward": { "strategy": "heat-penalty", "xp": 0 }, "failureConditions": ["heat:max"], "spawnRules": { "placement": "template-default", "priority": 86 } }
      },

      {
        "id": "metric-close-window",
        "sourceElement": { "type": "metric", "label": "Five-day close target", "description": "The team's standing goal is a five-business-day close with zero reopened periods.", "mediaRefs": [] },
        "gameBinding": { "gameEntityType": "district-hub", "interactionType": "drive", "mechanic": "payout-rate", "reward": { "strategy": "time-bonus-multiplier", "xp": 0 }, "spawnRules": { "placement": "template-default", "priority": 50 } }
