{
  "name": "optomole-skyrun-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "SkyRun: reference prototype proving the engine-agnostic gameplay DSL runs from pure data (RuntimeCore + PhaserAdapter).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --loader:.json=json --outdir=.test-build --out-extension:.js=.cjs --log-level=warning && node --test '.test-build/*.test.cjs'"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
