{
  "name": "optomole-build-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optomole build worker (Computer B). Consumes build jobs, invokes engine CLI tools, uploads artifacts to MinIO/S3.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=../.env index.js",
    "storage:selftest": "node --env-file=../.env selftest-storage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "amqplib": "^2.0.1",
    "archiver": "^7.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
