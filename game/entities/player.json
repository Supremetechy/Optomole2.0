{
  "id": "player",
  "archetype": "hero",
  "tags": ["player", "controllable"],
  "components": [
    {
      "type": "TransformComponent",
      "position": { "x": 0, "y": 2, "z": 0 },
      "scale": { "x": 1, "y": 1, "z": 1 }
    },
    {
      "type": "RenderComponent",
      "spriteId": "player_idle",
      "layer": "characters"
    },
    {
      "type": "PhysicsComponent",
      "bodyType": "dynamic",
      "colliderShape": { "type": "box", "width": 0.8, "height": 1.8 },
      "collisionTags": ["ground", "enemy", "goal"]
    },
    {
      "type": "InputComponent",
      "bindings": [
        { "action": "MoveLeft", "keys": ["A", "LeftArrow"] },
        { "action": "MoveRight", "keys": ["D", "RightArrow"] },
        { "action": "Jump", "keys": ["Space", "W", "UpArrow"] }
      ]
    },
    {
      "type": "StateComponent",
      "stateMachineId": "player_state_machine",
      "initialState": "Idle",
      "variables": {
        "isGrounded": true,
        "health": 3,
        "moveSpeed": 5,
        "jumpForce": 12
      }
    }
  ]
}